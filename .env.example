# Copy to .env and fill in values. `.env` is gitignored.
# Load with: set -a && source .env && set +a

# =============================================================================
# DEPLOYER
# =============================================================================
# EOA that signs deployment txs. Holds DEFAULT_ADMIN temporarily during the
# Deploy.s.sol run, then renounces it at the end (before this key, only
# EXECUTOR_ROLE and PAUSER_ROLE remain — rotate those via Timelock later).
PRIVATE_KEY=0x0

# =============================================================================
# GOVERNANCE (mainnet)
# =============================================================================
# Gnosis Safe multisig — sole admin of the Compound Timelock.
SAFE_ADDRESS=0x0

# Set AFTER you deploy the Compound Timelock in Step 2 of the runbook.
# Deploy.s.sol will grant DEFAULT_ADMIN_ROLE to this address and renounce
# the deployer's admin. The script reverts if this address has no code.
TIMELOCK_ADDRESS=0x7dD3AB088e5b6F4cd0c366eDaE81C5AC10A6e779

# =============================================================================
# RPC ENDPOINTS
# =============================================================================
# Referenced from foundry.toml [rpc_endpoints].
# Public endpoints — no API key required. Rate-limited; for production
# traffic swap these for an authenticated provider (Alchemy/Infura/QuickNode).
# Mainnet deploys and verifications work fine against these.
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# =============================================================================
# VERIFICATION
# =============================================================================
# Same Etherscan v2 API key works for Ethereum mainnet, Sepolia, and Arbitrum
# Sepolia. ETHERSCAN_KEY is kept separate because foundry.toml already
# distinguishes it for the Arbitrum Sepolia entry.
ETHERSCAN_API_KEY=
ETHERSCAN_KEY=

# =============================================================================
# DEPLOYED ADDRESSES (fill in AFTER Step 3 of MAINNET_DEPLOYMENT.md)
# =============================================================================
# Record these so cast verification commands in the runbook work cleanly.
DEPLOYER=0xf0d26d482785285e21b6d22f46719dbad2f7d87e
VAULT_ADDRESS=0xabf1f322c6626f283895597be3b8d52fc618ec21
SERA_ADDRESS=0xf25bf48392e9e402ef2661bf7530d0420716b565
SOR_ADDRESS=0x5a999e11a6959dbaafab93d2f64cd82497891681
BATCHER_ADDRESS=0x238399910636f41f351d20411ffae4deb8f2b9a5

# =============================================================================
# OPTIONAL — DeploySepolia.s.sol only (unused for mainnet Deploy.s.sol)
# =============================================================================
# EXECUTOR_ADDRESS=0x
# TREASURY_ADDRESS=0x
# PAUSER_ADDRESS=0x
# WHITELIST_TOKEN_COUNT=0
# WHITELIST_TOKEN_0=0x
# WHITELIST_MIN_0=1