# Copy to .env and fill in values. `.env` is gitignored.
# Load with: set -a && source .env && set +a

# =============================================================================
# DEPLOYER
# =============================================================================
# EOA that signs deployment transactions.
PRIVATE_KEY=0x0

# =============================================================================
# GOVERNANCE
# =============================================================================
# Timelock contract address.
TIMELOCK_ADDRESS=0x0

# =============================================================================
# RPC ENDPOINTS
# =============================================================================
# Referenced from foundry.toml [rpc_endpoints]. Public endpoints below are
# rate-limited; swap for an authenticated provider for production traffic.
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# =============================================================================
# VERIFICATION
# =============================================================================
# Etherscan v2 API key.
ETHERSCAN_API_KEY=
ETHERSCAN_KEY=

# =============================================================================
# DEPLOYED ADDRESSES (populate after deployment)
# =============================================================================
DEPLOYER=0x0
VAULT_ADDRESS=0x0
SERA_ADDRESS=0x0
SOR_ADDRESS=0x0
BATCHER_ADDRESS=0x0

# =============================================================================
# OPTIONAL
# =============================================================================
# EXECUTOR_ADDRESS=0x
# TREASURY_ADDRESS=0x
# PAUSER_ADDRESS=0x
# WALLET_1=0x
# WALLET_2=0x
# WHITELIST_TOKEN_COUNT=0
# WHITELIST_TOKEN_0=0x
# WHITELIST_MIN_0=1
